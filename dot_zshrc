# === D-Bus & Gnome Keyring for WSL/SSH ===
# 初始化 D-Bus 会话（如果尚未启动）
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    eval $(dbus-launch --sh-syntax)
    export DBUS_SESSION_BUS_ADDRESS
fi

# 启动并解锁 gnome-keyring
if [ -z "$GNOME_KEYRING_CONTROL" ]; then
    # 传入空字符解锁默认密钥环，并将输出的变量（如 GNOME_KEYRING_CONTROL）注入当前环境
    eval "$(echo '\n' | gnome-keyring-daemon --unlock 2>/dev/null)"
fi

