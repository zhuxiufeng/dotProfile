#!/usr/bin/env bash
#
# sshr - 自动配置免密 (auto ssh-copy-id) + MobaXterm 风格断线重连守护工具
#

if [ "$#" -lt 1 ]; then
    echo "使用方法: sshr <user@host> [其他 ssh 参数...]"
    echo "示例:     sshr root@192.168.1.101"
    echo "          sshr -p 2222 admin@10.0.0.5"
    exit 1
fi

TARGET="$1"
shift

# 获取本地默认公钥 (优先 ed25519)
PUB_KEY_FILE=""
if [ -f "$HOME/.ssh/id_ed25519.pub" ]; then
    PUB_KEY_FILE="$HOME/.ssh/id_ed25519.pub"
elif [ -f "$HOME/.ssh/id_rsa.pub" ]; then
    PUB_KEY_FILE="$HOME/.ssh/id_rsa.pub"
fi

# 1. 自动免密绑定逻辑
ensure_ssh_key() {
    [ -z "$PUB_KEY_FILE" ] && return 0

    # 先用 BatchMode 快速探测：如果已经能免密登录，直接跳过
    if ssh -o BatchMode=yes -o ConnectTimeout=2 -o StrictHostKeyChecking=no "$TARGET" "$@" exit 2>/dev/null; then
        return 0
    fi

    echo -e "\033[1;36m[+] 检测到目标设备未配置免密，正在自动注入 SSH 公钥...\033[0m"
    PUBKEY=$(cat "$PUB_KEY_FILE")
    
    # 远程注入命令：同时兼顾标准 Linux OpenSSH (~/.ssh) 与 嵌入式/创想 OpenWrt Dropbear (/etc/dropbear)
    REMOTE_SETUP='sh -c "
        mkdir -p ~/.ssh 2>/dev/null
        touch ~/.ssh/authorized_keys 2>/dev/null
        chmod 700 ~/.ssh 2>/dev/null
        chmod 600 ~/.ssh/authorized_keys 2>/dev/null
        grep -qF \"'"$PUBKEY"'\" ~/.ssh/authorized_keys 2>/dev/null || echo \"'"$PUBKEY"'\" >> ~/.ssh/authorized_keys 2>/dev/null
        if [ -d /etc/dropbear ]; then
            touch /etc/dropbear/authorized_keys 2>/dev/null
            chmod 600 /etc/dropbear/authorized_keys 2>/dev/null
            grep -qF \"'"$PUBKEY"'\" /etc/dropbear/authorized_keys 2>/dev/null || echo \"'"$PUBKEY"'\" >> /etc/dropbear/authorized_keys 2>/dev/null
        fi
    "'

    # 尝试常见出厂默认密码静默直连 (creality_5733 / root / admin)
    AUTO_INJECTED=0
    if command -v sshpass &>/dev/null; then
        for DEF_PASS in "creality_5733" "root" "admin"; do
            if sshpass -p "$DEF_PASS" ssh -o ConnectTimeout=2 -o StrictHostKeyChecking=no "$TARGET" "$@" "$REMOTE_SETUP" 2>/dev/null; then
                AUTO_INJECTED=1
                echo -e "\033[1;32m[✓] 自动识别出厂默认凭据成功！已静默写入公钥，后续将永久免密！\033[0m"
                break
            fi
        done
    fi

    # 若非默认密码，提示用户输入一次密码并自动写入公钥
    if [ "$AUTO_INJECTED" -eq 0 ]; then
        echo -e "\033[1;33m[!] 请输入一次目标机器密码，将自动绑定公钥免密：\033[0m"
        ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$TARGET" "$@" "$REMOTE_SETUP"
        if [ $? -eq 0 ]; then
            echo -e "\033[1;32m[✓] 公钥注入成功！后续连接将完全免密！\033[0m"
        fi
    fi
}

ensure_ssh_key

# 2. 进入交互会话与断线重连守护循环
while true; do
    ssh -o ServerAliveInterval=10 -o ServerAliveCountMax=3 "$TARGET" "$@"
    RET=$?
    echo -e "\n\033[1;33m>>> [连接断开 (退出码: $RET)] 按 [Enter] 键立即重连，输入 [q] 退出...\033[0m"
    read -r input || break
    if [[ "$input" == "q" || "$input" == "Q" ]]; then
        break
    fi
done
